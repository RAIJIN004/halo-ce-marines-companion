  (objects_detach (player0) mod_m05)
  (objects_attach (player0) "" mod_m06 "")
  (objects_detach (player0) mod_m06)
  (objects_attach (player0) "" mod_m07 "")
  (objects_detach (player0) mod_m07)
  (objects_attach (player0) "" mod_m08 "")
  (objects_detach (player0) mod_m08)
  (objects_attach (player0) "" mod_m09 "")
  (objects_detach (player0) mod_m09)
  (objects_attach (player0) "" mod_m10 "")
  (objects_detach (player0) mod_m10)
  (objects_attach (player0) "" mod_m11 "")
  (objects_detach (player0) mod_m11)
  (objects_attach (player0) "" mod_m12 "")
  (objects_detach (player0) mod_m12)
  (objects_attach (player0) "" mod_m13 "")
  (objects_detach (player0) mod_m13)
