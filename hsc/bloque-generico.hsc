  (objects_detach (player0) mod_m14)
  (objects_attach (player0) "" mod_m15 "")
  (objects_detach (player0) mod_m15)
  (objects_attach (player0) "" mod_m16 "")
  (objects_detach (player0) mod_m16)
  (objects_attach (player0) "" mod_m17 "")
  (objects_detach (player0) mod_m17)
  (objects_attach (player0) "" mod_m18 "")
  (objects_detach (player0) mod_m18)
  (objects_attach (player0) "" mod_m19 "")
  (objects_detach (player0) mod_m19)
  (objects_attach (player0) "" mod_m20 "")
  (objects_detach (player0) mod_m20)
